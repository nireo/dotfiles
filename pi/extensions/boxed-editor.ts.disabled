import {
	CustomEditor,
	type ExtensionAPI,
	type KeybindingsManager,
} from "@earendil-works/pi-coding-agent";
import type { EditorTheme, TUI } from "@earendil-works/pi-tui";

/**
 * Turns pi's two horizontal editor rules into a complete expanding box.
 * The built-in editor still owns editing, wrapping, history, and autocomplete.
 */
class BoxedEditor extends CustomEditor {
	constructor(tui: TUI, theme: EditorTheme, keybindings: KeybindingsManager) {
		super(tui, theme, keybindings, { paddingX: 0 });
	}

	render(width: number): string[] {
		if (width < 3) return super.render(width);
		const innerWidth = width - 2;
		const lines = super.render(innerWidth);
		if (lines.length < 2) return lines;

		const border = (text: string) => this.borderColor(text);
		const left = border("│");
		const right = border("│");
		const framed = lines.map((line) => `${left}${line}${right}`);

		framed[0] = `${border("╭")}${lines[0]}${border("╮")}`;

		if (this.isShowingAutocomplete()) {
			// Keep the editor's lower rule as a separator above autocomplete,
			// then close the enlarged frame below the suggestions.
			framed.push(`${border("╰")}${border("─".repeat(innerWidth))}${border("╯")}`);
		} else {
			const last = lines.length - 1;
			framed[last] = `${border("╰")}${lines[last]}${border("╯")}`;
		}

		return framed;
	}
}

export default function (pi: ExtensionAPI) {
	pi.on("session_start", (_event, ctx) => {
		if (ctx.mode !== "tui") return;
		ctx.ui.setEditorComponent((tui, theme, keybindings) =>
			new BoxedEditor(tui, theme, keybindings),
		);
	});
}
