{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "agent": {
    "implementer": {
      "description": "Implements a scoped coding task and verifies the result. Use as an implementation worker, especially when independent work can run in parallel.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "max",
      "prompt": "{file:./prompts/implementation-subagent.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  },
  "theme": "system"
}
